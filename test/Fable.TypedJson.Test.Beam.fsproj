<?xml version="1.0" encoding="utf-8"?>
<!--
BEAM test project. Its reference set is exactly what a Fable.TypedJson.Beam consumer
gets — see Fable.TypedJson.Test.Beam.fsproj.paket.references.

decision: uses one test project per target — Fable merges referenced sources and resolves packages from the root project
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <LangVersion>preview</LangVersion>
    <OutputType>Exe</OutputType>
    <DefineConstants>FABLE_COMPILER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Fable.TypedJson/Fable.TypedJson.fsproj" />
    <ProjectReference Include="../src/Fable.TypedJson.Beam/Fable.TypedJson.Beam.fsproj" />
  </ItemGroup>
  <Import Project="Tests.props" />
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
