{erl_opts, [debug_info]}.

%% The test project references every backend's Fable bindings (see the Test
%% group in paket.dependencies), so Fable emits Fable.Python's Python-only
%% sources into this build too. They are never called from Erlang and do not
%% compile, so the app dirs are an allowlist rather than `fable_modules/*`.
{project_app_dirs, [
    ".",
    "fable_modules/fable-library-beam",
    "fable_modules/Fable.Beam*",
    "fable_modules/Scriptorium*"
]}.

{deps, [
    {jsx, "3.1.0"}
]}.
