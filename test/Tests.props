<?xml version="1.0" encoding="utf-8"?>
<!--
The test sources are one shared set; only the project files differ per backend.

decision: compile order lives here, not in each fsproj — four copies would drift silently
invariant: a new test module is added here once and picked up by all four targets
-->
<Project>
  <ItemGroup>
    <Compile Include="Testing.fs" />
    <Compile Include="TestEncode.fs" />
    <Compile Include="TestAuto.fs" />
    <Compile Include="TestCaseRules.fs" />
    <Compile Include="TestErrors.fs" />
    <Compile Include="TestErasedDU.fs" />
    <Compile Include="TestSchema.fs" />
    <Compile Include="TestCodec.fs" />
    <Compile Include="TestRefined.fs" />
    <Compile Include="TestNested.fs" />
    <Compile Include="TestJsonSchema.fs" />
    <Compile Include="TestAlias.fs" />
    <Compile Include="TestUnion.fs" />
    <Compile Include="TestScalars.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
</Project>
