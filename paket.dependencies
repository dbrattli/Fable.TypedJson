# https://fsprojects.github.io/Paket/nuget-dependencies.html
#
# Library packages target netstandard2.0 (broad consumability when published
# to NuGet). The Test group targets net10.0 since the test runner runs on
# .NET (it's the host that drives Fable to transpile to BEAM/Python and
# then runs those targets).
#
#   Main   → Fable.TypedJson (backend-agnostic core, netstandard2.0)
#   Beam   → Fable.TypedJson.Beam (netstandard2.0)
#   Python → Fable.TypedJson.Python (netstandard2.0)
#   JS     → Fable.TypedJson.JS (netstandard2.0)
#   DotNet → Fable.TypedJson.DotNet (net8.0 — runs natively on the CLR)
#   Test   → Fable.TypedJson.Test (net10.0)
#
# Each project's `paket.references` opts into its single group.

source https://api.nuget.org/v3/index.json
storage: none
framework: netstandard2.0

nuget FSharp.Core >= 5.0.0 lowest_matching: true
nuget Fable.Core >= 5.0.0 lowest_matching: true

# BEAM (Erlang) backend
group Beam
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: netstandard2.0

    nuget FSharp.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Beam >= 5.0.0-rc.27
    nuget Fable.Beam.Jsx >= 5.0.0-rc.8

# Python backend
group Python
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: netstandard2.0

    nuget FSharp.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Python >= 5.1.0

# JavaScript backend -- only Fable.Core is needed; the shim uses raw
# [<Emit>] for JSON.parse / JSON.stringify and JS native type tests.
group JS
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: netstandard2.0

    nuget FSharp.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true

# .NET backend -- pure CLR shim over System.Text.Json. Unlike the Fable
# targets, this one actually executes on the CLR, so [<Erase>] does NOT
# erase JsonValue and the shim must wrap raw values into real DU cases
# at the IJsonBackend boundary (one allocation per Get / per primitive).
group DotNet
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: net10.0

    nuget FSharp.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true
    nuget System.Text.Json >= 8.0.5 lowest_matching: true

# Test runner (host process). Tests transpile the same F# source to BOTH
# BEAM and Python via #if PYTHON, so this group includes every backend's
# Fable bindings — Fable's source-walking compiler needs them all visible
# under one project's reference set.
group Test
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: net10.0

    nuget FSharp.Core
    nuget Fable.Core
    nuget Fable.Beam >= 5.0.0-rc.27
    nuget Fable.Beam.Jsx >= 5.0.0-rc.8
    nuget Fable.Python >= 5.1.0
