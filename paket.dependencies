# https://fsprojects.github.io/Paket/nuget-dependencies.html
#
# Library packages target netstandard2.0 (broad consumability when published
# to NuGet). The Test group targets net10.0 since the test runner runs on
# .NET (it's the host that drives Fable to transpile to BEAM/Python and
# then runs those targets).
#
#   Main   → Fable.TypedJson (backend-agnostic core, netstandard2.0)
#   Beam   → Fable.TypedJson.Beam (netstandard2.0)
#   Python → Fable.TypedJson.Python (netstandard2.0)
#   JS     → Fable.TypedJson.JS (netstandard2.0)
#   DotNet → Fable.TypedJson.DotNet (net8.0 — runs natively on the CLR)
#   Test   → Fable.TypedJson.Test (net10.0)
#
# Each project's `paket.references` opts into its single group.
# decision: FSharp.Core 6 is the library floor because SDK 10.0.400 emits unsupported dynamic operator calls against 5.x

source https://api.nuget.org/v3/index.json
storage: none
framework: netstandard2.0

nuget FSharp.Core >= 6.0.0 lowest_matching: true
nuget Fable.Core >= 5.0.0 lowest_matching: true

# BEAM (Erlang) backend
group Beam
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: netstandard2.0

    nuget FSharp.Core >= 6.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Beam >= 5.0.0-rc.37
    nuget Fable.Beam.Jsx >= 5.0.0-rc.9

# Python backend
group Python
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: netstandard2.0

    nuget FSharp.Core >= 6.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true
    nuget Fable.Python >= 5.1.0

# JavaScript backend -- only Fable.Core is needed; the shim uses raw
# [<Emit>] for JSON.parse / JSON.stringify and JS native type tests.
group JS
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: netstandard2.0

    nuget FSharp.Core >= 6.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true

# .NET backend -- pure CLR shim over System.Text.Json. Unlike the Fable
# targets, this one actually executes on the CLR, so [<Erase>] does NOT
# erase JsonValue and the shim must wrap raw values into real DU cases
# at the IJsonBackend boundary (one allocation per Get / per primitive).
group DotNet
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: net10.0

    nuget FSharp.Core >= 6.0.0 lowest_matching: true
    nuget Fable.Core >= 5.0.0 lowest_matching: true
    nuget System.Text.Json >= 8.0.5 lowest_matching: true

# Test runner (host process). The same F# source is transpiled to every
# target via #if PYTHON / #if JS / #if DOTNET, and Scriptorium (Quill runner +
# Nib assertions) compiles to all four, so one suite drives them all.
#
# This group is the union of what the four targets need, but no single project
# references all of it: each test/<project>.fsproj.paket.references names only
# its own backend. That matters because Fable's source-walking compiler merges
# a referenced shim project into the root compilation and resolves the shim's
# packages from the root project's reference set — so a project that named all
# four backends would emit e.g. Fable.Python's sources into the Erlang build.
group Test
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: net10.0

    nuget FSharp.Core
    nuget Fable.Core
    nuget Fable.Beam >= 5.0.0-rc.37
    nuget Fable.Beam.Jsx >= 5.0.0-rc.9
    nuget Fable.Python >= 5.1.0
    nuget Scriptorium.Quill >= 0.5.1
    nuget Scriptorium.Nib >= 0.4.1

# Benchmarks (host process, .NET only — benchmarks/dotnet). Never shipped; this
# group exists so the benchmark project restores. BenchmarkDotNet drives the run;
# Thoth.Json supplies the comparison baselines (hand-written Decode.object via the
# System.Text.Json backend, and reflection-driven Decode.Auto via the Net backend).
# System.Text.Json itself arrives transitively through the .NET shim's project
# reference, so it is not listed here.
group Benchmark
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: net10.0

    nuget FSharp.Core
    nuget BenchmarkDotNet ~> 0.14.0
    nuget Thoth.Json
    nuget Thoth.Json.System.Text.Json
    nuget Thoth.Json.Net
